# Normalize line endings so the working tree is consistent. Mixed CRLF/LF across source
# files silently breaks text tooling that matches on newlines.
* text=auto eol=crlf

# Scripts whose interpreters require LF.
*.sh text eol=lf

# Binary assets must never be normalized.
*.png binary
*.ico binary
*.mp4 binary
*.zip binary
*.exe binary
*.dll binary
