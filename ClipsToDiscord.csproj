<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClipsToDiscord</AssemblyName>
    <RootNamespace>ClipsToDiscord</RootNamespace>
    <Product>ClipCord</Product>
    <AssemblyTitle>ClipCord</AssemblyTitle>
    <Description>Automatically relay completed gaming clips to Discord.</Description>
    <Version>1.7.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\ClipsToDiscord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="assets\app-icon.png" LogicalName="ClipsToDiscord.Assets.AppIcon.png" />
  </ItemGroup>
</Project>
